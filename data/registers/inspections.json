      "req": true
    },
    {
      "key": "kind",
      "label": "검사 구분",
      "type": "select",
      "options": [
        "수입검사",
        "공정검사",
        "출하검사",
        "AFT / VBT / EOL 전수검사",
        "Safe Launch / EPC 방화벽 검사",
        "기술적 청정도 (ISO 16232)"
      ],
      "req": true
    },
    {
      "key": "line",
      "label": "라인",
      "type": "ref",
      "ref": "lines"
    },
    {
      "key": "vendor",
      "label": "협력사",
      "type": "ref",
      "ref": "vendors"
    },
    {
      "key": "part",
      "label": "부품",
      "type": "ref",
      "ref": "parts"
    },
    {
      "key": "inspected",
      "label": "검사 수량",
      "type": "number",
      "req": true
    },
    {
      "key": "defects",
      "label": "불량 수량",
      "type": "number"
    },
    {
      "key": "rate",
      "label": "불량률 (%)",
