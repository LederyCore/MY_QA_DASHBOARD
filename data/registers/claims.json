      "options": [
        "0-km (고객 입고·조립라인)",
        "필드 보증 (Warranty Return)",
        "초기유동 (Safe Launch / EPC)"
      ],
      "colors": {
        "0-km (고객 입고·조립라인)": "red",
        "필드 보증 (Warranty Return)": "orange",
        "초기유동 (Safe Launch / EPC)": "purple"
      }
    },
    {
      "key": "customer",
      "label": "고객사",
      "type": "ref",
      "ref": "customers",
      "req": true
    },
    {
      "key": "part",
      "label": "부품",
      "type": "ref",
      "ref": "parts"
    },
    {
      "key": "type",
      "label": "불량 유형",
      "type": "ref",
      "ref": "defecttypes"
    },
    {
      "key": "qty",
      "label": "수량",
      "type": "number"
    },
    {
      "key": "cost",
      "label": "클레임 비용(만원)",
      "type": "number"
    },
    {
      "key": "unitcost",
      "label": "건당 비용(만원)",
      "type": "formula",
      "expr": "round({클레임 비용(만원)} / {수량}, 1)"
    },
    {
      "key": "ntf_check",
      "label": "회수품 NTF · 재현 검증",
      "type": "select",
      "options": [
        "분해 전 비파괴·AFT/EOL·리크 재현 완료 (진성 불량)",
        "내구·리크 재현 시험 결과 누수 없음 (NTF / 초기 일시적 삼출)",
        "회수품 입수 대기",
        "해당 없음"
      ]
    },
    {
      "key": "lot_trace",
      "label": "불량 로트 · 2D 바코드 시리얼",
      "type": "text"
    },
    {
      "key": "owner",
      "label": "담당",
      "type": "ref",
      "ref": "people"
    },
    {
      "key": "status",
      "label": "상태",
      "type": "select",
      "options": [
        "접수",
        "조사중",
        "대책수립",
        "완료"
